# Ignore LaTeX auxiliary and temporary files
*.aux
*.lof
*.lot
*.fls
*.out
*.toc
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.run.xml
*.log

# Ignore everything in the report folder except PDFs
report/*
!report/*.pdf
!report/*.bib
!report/*.cls
!report/**/
!report/**/*.tex

# Ignore Python cache files
__pycache__/
*.pyc
*.pyo

# Ignore Docker build artifacts
dist/
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip
*.tgz
*.egg-info/
*.egg
*.whl

# Ignore environment files
.env
*.env

# Ignore all data inside data
**/data/**

# these bits are from 23 comp_metric
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
